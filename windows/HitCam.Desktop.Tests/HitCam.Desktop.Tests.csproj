<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <IsPackable>false</IsPackable>
    <!-- Reads the fixed arrays of the structs shared with the DLL. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Renders controls without a window on screen (overlays over the preview). -->
    <PackageReference Include="Avalonia.Headless" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- View models only; the native camera DLL is not needed (CI passes -p:SkipVirtualCamera=true). No
         AdditionalProperties here: a second HitCam.Desktop build with other global properties races the first one
         over the same obj folder in a parallel solution build (CS2012). -->
    <ProjectReference Include="..\HitCam.Desktop\HitCam.Desktop.csproj" />
  </ItemGroup>
</Project>
