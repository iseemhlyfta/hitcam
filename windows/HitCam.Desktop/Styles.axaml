<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource HcGround}" />
        <Setter Property="Foreground" Value="{DynamicResource HcText}" />
    </Style>

    <!--  Text  -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontFamily" Value="{StaticResource HcDisplayFont}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.strong">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource HcText2}" />
    </Style>
    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="Foreground" Value="{DynamicResource HcText2}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  Surfaces  -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource HcSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HcBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Border.stat">
        <Setter Property="Background" Value="{DynamicResource HcSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HcBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Border.well">
        <Setter Property="Background" Value="{DynamicResource HcSurface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HcBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.softAccent">
        <Setter Property="Background" Value="{DynamicResource HcAccentSoft}" />
    </Style>
    <Style Selector="Border.overlay">
        <Setter Property="Background" Value="{StaticResource HcOverlay}" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <!--  Icons: 24x24 stroke paths, colored by the surrounding foreground  -->
    <Style Selector="Path.icon">
        <Setter Property="Stroke" Value="{Binding $parent[ContentPresenter].Foreground, FallbackValue={StaticResource HcOnVideo}}" />
        <Setter Property="StrokeThickness" Value="1.7" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
    </Style>

    <!--  Buttons  -->
    <Style Selector="Button, ToggleButton">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource HcAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource HcOnAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="18,0" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HcAccentHover}" />
        <Setter Property="Foreground" Value="{DynamicResource HcOnAccent}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HcAccentHover}" />
        <Setter Property="Foreground" Value="{DynamicResource HcOnAccent}" />
    </Style>

    <Style Selector="Button.secondary, ToggleButton.tile, Button.tile">
        <Setter Property="Background" Value="{DynamicResource HcSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HcBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource HcText}" />
    </Style>
    <Style Selector="Button.secondary">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
    </Style>
    <Style Selector="ToggleButton.tile, Button.tile">
        <Setter Property="Background" Value="{DynamicResource HcSurface2}" />
        <Setter Property="Height" Value="44" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ToggleButton.tile:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HcAccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HcAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource HcAccentSoftText}" />
    </Style>
    <Style Selector="ToggleButton.tile:checked">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="ToggleButton.pill">
        <Setter Property="Height" Value="22" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource HcSurface2}" />
        <Setter Property="Foreground" Value="{DynamicResource HcText2}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ToggleButton.pill:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HcAccentSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource HcAccentSoftText}" />
    </Style>

    <Style Selector="Button.onVideo">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{StaticResource HcOverlay}" />
        <Setter Property="Foreground" Value="{StaticResource HcOnVideo}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.onVideo:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource HcVideo}" />
        <Setter Property="Foreground" Value="{StaticResource HcOnVideo}" />
    </Style>

    <!--  Segmented control (lens)  -->
    <!--  Segmented lists never scroll: bringing the selection into view would scroll the whole settings panel.  -->
    <Style Selector="ListBox.segmented">
        <Setter Property="AutoScrollToSelectedItem" Value="False" />
        <Setter Property="Background" Value="{DynamicResource HcSurface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HcBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem">
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HcSelected}" />
        <Setter Property="Foreground" Value="{DynamicResource HcText}" />
        <Setter Property="BoxShadow" Value="0 1 2 0 #1F000000" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:selected">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!--  An option the device does not offer (phone camera noise reduction)  -->
    <Style Selector="ListBox.segmented ListBoxItem:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!--  Sliders drawn over a colored track (white balance)  -->
    <Style Selector="Border.gradientTrack">
        <Setter Property="Height" Value="4" />
        <Setter Property="Margin" Value="10,0" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Slider.gradient /template/ RepeatButton#PART_DecreaseButton, Slider.gradient /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Slider.gradient:pointerover /template/ RepeatButton#PART_DecreaseButton, Slider.gradient:pointerover /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Slider.gradient:pressed /template/ RepeatButton#PART_DecreaseButton, Slider.gradient:pressed /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource HcSurface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HcBorder}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
</Styles>
