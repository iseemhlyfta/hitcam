<UserControl
    x:Class="HitCam.Desktop.Views.StreamingView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="clr-namespace:HitCam.Desktop.Services"
    xmlns:vm="clr-namespace:HitCam.Desktop.ViewModels"
    xmlns:views="clr-namespace:HitCam.Desktop.Views"
    x:DataType="vm:MainViewModel">

    <Grid Margin="16,4,16,16" ColumnDefinitions="*,Auto" ColumnSpacing="16">

        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">

            <!--  Phone  -->
            <Grid Height="52" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" IsVisible="{Binding IsNotFullScreen}">
                <Border Width="40" Height="40" Classes="card" CornerRadius="10">
                    <Path Classes="icon" Width="18" Height="18" StrokeThickness="1.6" Stroke="{DynamicResource HcText}" Data="{StaticResource IconPhone}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding DeviceName}" />
                    <TextBlock Classes="muted" Text="{Binding DeviceSubtitle}" />
                </StackPanel>
                <Border Grid.Column="2" Height="30" Padding="12,0" VerticalAlignment="Center" Background="{DynamicResource HcOkSoft}" CornerRadius="15"
                        IsVisible="{Binding IsCameraReady}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource HcOk}" />
                        <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource HcOk}" Text="{x:Static svc:Loc.CameraLiveBadge}" />
                    </StackPanel>
                </Border>
                <Button Grid.Column="3" VerticalAlignment="Center" Classes="secondary" Command="{Binding DisconnectCommand}" Content="{x:Static svc:Loc.Disconnect}" />
            </Grid>

            <!--  Preview; stays dark in both themes  -->
            <Border Grid.Row="1"
                    Background="{StaticResource HcVideo}" CornerRadius="12" ClipToBounds="True"
                    DoubleTapped="OnPreviewDoubleTapped">
                <Panel>
                  <!--  The picture and what is drawn on it; a shot kicks all of it  -->
                  <Panel x:Name="PreviewContent">
                    <Image Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="MediumQuality" />
                    <!--  Detected objects, mapped through the same letterboxing as the image  -->
                    <views:DetectionOverlay Source="{Binding Preview}" Tracks="{Binding Vision.Tracks}" IsVisible="{Binding ShowDetections}" />
                    <!--  Tracked hands: dots on the fingers, lines if asked  -->
                    <!--  Threads between fingertips of the two hands and the fills between them  -->
                    <views:ThreadOverlay Source="{Binding Preview}" Threads="{Binding Hands.Threads}" Fills="{Binding Hands.Fills}"
                                         LeftColor="{Binding Hands.LeftColor}" RightColor="{Binding Hands.RightColor}" FillOpacity="{Binding Hands.FillOpacity}"
                                         IsVisible="{Binding ShowHands}" />
                    <views:HandOverlay Source="{Binding Preview}" Hands="{Binding Hands.Hands}" ShowSkeleton="{Binding Hands.ShowSkeleton}" IsVisible="{Binding ShowHandPoints}" />
                    <!--  Finger-gun shots: flash here, kick on the whole panel  -->
                    <views:ShotOverlay Source="{Binding Preview}" Shots="{Binding Hands.Shots}" ShakeTarget="{Binding #PreviewContent}" IsVisible="{Binding ShowHands}" />
                  </Panel>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsVisible="{Binding !HasPreview}">
                        <Path Classes="icon" Width="40" Height="40" StrokeThickness="1.4" Stroke="{StaticResource HcVideoMuted}" Data="{StaticResource IconVideo}" />
                        <TextBlock FontSize="13" Foreground="{StaticResource HcVideoMuted}" Text="{x:Static svc:Loc.WaitingForFrame}" />
                    </StackPanel>
                    <Border Margin="14" HorizontalAlignment="Left" VerticalAlignment="Top" Classes="overlay"
                            IsVisible="{Binding LiveText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource HcLive}" />
                            <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource HcOnVideo}" Text="{Binding LiveText}" />
                        </StackPanel>
                    </Border>
                    <Button Margin="14" HorizontalAlignment="Right" VerticalAlignment="Top" Classes="onVideo" Command="{Binding ToggleFullScreenCommand}"
                            ToolTip.Tip="{x:Static svc:Loc.Fullscreen}" AutomationProperties.Name="{x:Static svc:Loc.Fullscreen}" IsVisible="{Binding IsNotFullScreen}">
                        <Path Classes="icon" StrokeThickness="1.8" Stroke="{StaticResource HcOnVideo}" Data="{StaticResource IconFullscreen}" />
                    </Button>
                    <Button Margin="14" HorizontalAlignment="Right" VerticalAlignment="Top" Classes="onVideo" Command="{Binding ToggleFullScreenCommand}"
                            ToolTip.Tip="{x:Static svc:Loc.ExitFullscreen}" AutomationProperties.Name="{x:Static svc:Loc.ExitFullscreen}" IsVisible="{Binding IsFullScreen}">
                        <Path Classes="icon" StrokeThickness="1.8" Stroke="{StaticResource HcOnVideo}" Data="{StaticResource IconExitFullscreen}" />
                    </Button>
                </Panel>
            </Border>

            <!--  Stream stats  -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="10" IsVisible="{Binding IsNotFullScreen}">
                <Border Classes="stat">
                    <StackPanel Spacing="3">
                        <TextBlock Classes="muted" Text="{x:Static svc:Loc.Stream}" />
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding StreamText}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="stat">
                    <StackPanel Spacing="3">
                        <TextBlock Classes="muted" Text="{x:Static svc:Loc.Received}" />
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding ReceivedText}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="stat">
                    <StackPanel Spacing="3">
                        <TextBlock Classes="muted" Text="{x:Static svc:Loc.Latency}" />
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding LatencyText}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Classes="stat">
                    <StackPanel Spacing="3">
                        <TextBlock Classes="muted" Text="{x:Static svc:Loc.Phone}" />
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding PhoneText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!--  Camera settings  -->
        <Border Grid.Column="1" Width="320" Classes="card" IsVisible="{Binding IsNotFullScreen}">
            <DockPanel>
                <!--  Only when the camera needs something: installing, an update, an error  -->
                <Border Margin="20,0,20,18" Padding="12" DockPanel.Dock="Bottom" CornerRadius="10" Classes="softAccent"
                        IsVisible="{Binding IsCameraAttention}">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="strong" Text="{Binding CameraTitle}" />
                            <TextBlock Classes="muted" Text="{Binding CameraDetail}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button HorizontalAlignment="Stretch" Classes="primary" Height="36" Command="{Binding InstallCameraCommand}" Content="{Binding InstallCameraLabel}"
                                IsVisible="{Binding CanInstallCamera}" />
                    </StackPanel>
                </Border>

                <TabControl Classes="panelTabs" SelectedIndex="0">
                  <TabItem Header="{x:Static svc:Loc.TabCamera}">
                <ScrollViewer>
                    <StackPanel>
                    <StackPanel Margin="20,14,20,16" DataContext="{Binding Controls}" x:DataType="vm:CameraControlsViewModel" Spacing="16">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="title" Text="{x:Static svc:Loc.CameraSettings}" />
                            <TextBlock Classes="muted" Text="{x:Static svc:Loc.CameraSettingsHint}" />
                        </StackPanel>
                        <TextBlock Classes="muted" Text="{x:Static svc:Loc.WaitingForPhoneSettings}" IsVisible="{Binding !IsAvailable}" />

                        <StackPanel IsEnabled="{Binding IsAvailable}" Spacing="16">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="muted" Text="{x:Static svc:Loc.Lens}" />
                                <ListBox Classes="segmented" ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}"
                                         AutomationProperties.Name="{x:Static svc:Loc.Lens}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CameraOption">
                                            <TextBlock HorizontalAlignment="Center" Text="{Binding Label}" ToolTip.Tip="{Binding Name}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="muted" Text="{x:Static svc:Loc.Quality}" />
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}"
                                          AutomationProperties.Name="{x:Static svc:Loc.Quality}" />
                            </StackPanel>

                            <StackPanel IsVisible="{Binding CanZoom}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold" Text="{Binding ZoomText}" />
                                    <TextBlock Classes="muted" Text="{x:Static svc:Loc.Zoom}" />
                                </DockPanel>
                                <Slider Maximum="{Binding MaxZoom}" Minimum="{Binding MinZoom}" Value="{Binding Zoom}" AutomationProperties.Name="{x:Static svc:Loc.Zoom}" />
                            </StackPanel>

                            <StackPanel>
                                <DockPanel>
                                    <ToggleButton Margin="8,0,0,0" DockPanel.Dock="Right" Classes="pill" Content="{x:Static svc:Loc.ExposureLock}"
                                                  IsChecked="{Binding IsExposureLocked}" IsVisible="{Binding SupportsExposureLock}"
                                                  ToolTip.Tip="{x:Static svc:Loc.ExposureLockHint}" />
                                    <TextBlock VerticalAlignment="Center" DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold" Text="{Binding ExposureText}" />
                                    <TextBlock VerticalAlignment="Center" Classes="muted" Text="{x:Static svc:Loc.Exposure}" />
                                </DockPanel>
                                <Slider Maximum="2" Minimum="-2" Value="{Binding ExposureBias}" IsEnabled="{Binding CanAdjustExposure}"
                                        AutomationProperties.Name="{x:Static svc:Loc.Exposure}" />
                            </StackPanel>

                            <StackPanel IsVisible="{Binding SupportsWhiteBalance}">
                                <DockPanel>
                                    <ToggleButton Margin="8,0,0,0" DockPanel.Dock="Right" Classes="pill" Command="{Binding AutoWhiteBalanceCommand}"
                                                  Content="{x:Static svc:Loc.AutoFocus}" IsChecked="{Binding IsAutoWhiteBalance, Mode=OneWay}" />
                                    <TextBlock VerticalAlignment="Center" DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold" Text="{Binding WhiteBalanceText}" />
                                    <TextBlock VerticalAlignment="Center" Classes="muted" Text="{x:Static svc:Loc.WhiteBalance}" />
                                </DockPanel>
                                <!--  Warm light on the left, daylight on the right  -->
                                <Panel>
                                    <Border Classes="gradientTrack" Background="{StaticResource HcTemperatureGradient}" />
                                    <Slider Classes="gradient" Maximum="8000" Minimum="2500" SmallChange="50" LargeChange="500" Value="{Binding WhiteBalanceTemperature}"
                                        ToolTip.Tip="{x:Static svc:Loc.WhiteBalanceHint}" AutomationProperties.Name="{x:Static svc:Loc.WhiteBalance}" />
                                </Panel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold" Text="{Binding WhiteBalanceTintText}" />
                                    <TextBlock Classes="muted" Text="{x:Static svc:Loc.Tint}" />
                                </DockPanel>
                                <Panel>
                                    <Border Classes="gradientTrack" Background="{StaticResource HcTintGradient}" />
                                    <Slider Classes="gradient" Maximum="100" Minimum="-100" SmallChange="1" LargeChange="10" Value="{Binding WhiteBalanceTint}"
                                        ToolTip.Tip="{x:Static svc:Loc.TintHint}" AutomationProperties.Name="{x:Static svc:Loc.Tint}" />
                                </Panel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding SupportsFocus}">
                                <DockPanel>
                                    <ToggleButton DockPanel.Dock="Right" Classes="pill" Command="{Binding AutoFocusCommand}" Content="{x:Static svc:Loc.AutoFocus}"
                                                  IsChecked="{Binding IsAutoFocus, Mode=OneWay}" />
                                    <TextBlock VerticalAlignment="Center" Classes="muted" Text="{x:Static svc:Loc.Focus}" />
                                </DockPanel>
                                <Slider Maximum="1" Minimum="0" Value="{Binding LensPosition}" AutomationProperties.Name="{x:Static svc:Loc.Focus}" />
                            </StackPanel>

                            <StackPanel Spacing="6" IsVisible="{Binding SupportsStabilization}">
                                <TextBlock Classes="muted" Text="{x:Static svc:Loc.Stabilization}" ToolTip.Tip="{x:Static svc:Loc.StabilizationHint}" />
                                <ListBox Classes="segmented" ItemsSource="{Binding StabilizationOptions}" SelectedItem="{Binding SelectedStabilization}"
                                         ToolTip.Tip="{x:Static svc:Loc.StabilizationHint}" AutomationProperties.Name="{x:Static svc:Loc.Stabilization}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StabilizationOption">
                                            <TextBlock HorizontalAlignment="Center" Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <ToggleButton Classes="tile" IsChecked="{Binding Torch}" IsEnabled="{Binding HasTorch}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon" Data="{StaticResource IconTorch}" />
                                        <TextBlock VerticalAlignment="Center" Text="{x:Static svc:Loc.Torch}" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Grid.Column="1" Classes="tile" IsChecked="{Binding Mirror}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon" Data="{StaticResource IconMirror}" />
                                        <TextBlock VerticalAlignment="Center" Text="{x:Static svc:Loc.Mirror}" />
                                    </StackPanel>
                                </ToggleButton>
                                <Button Grid.Column="2" Classes="tile" Command="{Binding RotateCommand}" ToolTip.Tip="{x:Static svc:Loc.Rotate}"
                                        AutomationProperties.Name="{x:Static svc:Loc.Rotate}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon" Data="{StaticResource IconRotate}" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding RotationText}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!--  Processing: on this PC (sliders, NVIDIA) and, for noise, also on the phone before compression  -->
                    <Border Margin="20,0,20,16" Padding="0,16,0,0" BorderBrush="{DynamicResource HcBorder}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="title" Text="{x:Static svc:Loc.Processing}" />
                                <TextBlock Classes="muted" Text="{x:Static svc:Loc.ProcessingHint}" TextWrapping="Wrap" />
                            </StackPanel>

                            <!--  Noise reduction  -->
                            <StackPanel Spacing="12">
                                <TextBlock Classes="strong" Text="{x:Static svc:Loc.NoiseReduction}" />

                                <StackPanel DataContext="{Binding Processing}" x:DataType="vm:ProcessingViewModel">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold" Text="{Binding TemporalStrengthText}" />
                                        <TextBlock Classes="muted" Text="{x:Static svc:Loc.TemporalNoiseReduction}" ToolTip.Tip="{x:Static svc:Loc.TemporalNoiseReductionHint}" />
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding TemporalStrength}" ToolTip.Tip="{x:Static svc:Loc.TemporalNoiseReductionHint}"
                                            AutomationProperties.Name="{x:Static svc:Loc.TemporalNoiseReduction}" />
                                </StackPanel>

                                <StackPanel Spacing="6" DataContext="{Binding Processing}" x:DataType="vm:ProcessingViewModel"
                                            IsVisible="{Binding IsArtifactReductionAvailable}">
                                    <TextBlock Classes="muted" Text="{x:Static svc:Loc.ArtifactReduction}" TextWrapping="Wrap"
                                               ToolTip.Tip="{x:Static svc:Loc.ArtifactReductionHint}" />
                                    <ListBox Classes="segmented" ItemsSource="{Binding ArtifactReductionOptions}" SelectedItem="{Binding SelectedArtifactReduction}"
                                             ToolTip.Tip="{x:Static svc:Loc.ArtifactReductionHint}" AutomationProperties.Name="{x:Static svc:Loc.ArtifactReduction}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ArtifactReductionOption">
                                                <TextBlock HorizontalAlignment="Center" Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <StackPanel Spacing="6" DataContext="{Binding Controls}" x:DataType="vm:CameraControlsViewModel"
                                            IsVisible="{Binding SupportsNoiseReduction}">
                                    <TextBlock Classes="muted" Text="{x:Static svc:Loc.PhoneNoiseReduction}" ToolTip.Tip="{x:Static svc:Loc.PhoneNoiseReductionHint}" />
                                    <ListBox Classes="segmented" ItemsSource="{Binding NoiseReductionOptions}" SelectedItem="{Binding SelectedNoiseReduction}"
                                             IsEnabled="{Binding IsAvailable}" ToolTip.Tip="{x:Static svc:Loc.PhoneNoiseReductionHint}"
                                             AutomationProperties.Name="{x:Static svc:Loc.PhoneNoiseReduction}">
                                        <ListBox.Styles>
                                            <!--  Modes the phone's camera does not have stay visible but cannot be picked  -->
                                            <Style Selector="ListBoxItem" x:DataType="vm:NoiseReductionOption">
                                                <Setter Property="IsEnabled" Value="{Binding IsOffered}" />
                                            </Style>
                                        </ListBox.Styles>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:NoiseReductionOption">
                                                <TextBlock HorizontalAlignment="Center" Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </StackPanel>

                            <!--  Colour and sharpness  -->
                            <StackPanel Spacing="10" DataContext="{Binding Processing}" x:DataType="vm:ProcessingViewModel">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Classes="secondary" Height="28" Padding="10,0" FontSize="12"
                                            Command="{Binding ResetColorCommand}" Content="{x:Static svc:Loc.ResetColor}"
                                            ToolTip.Tip="{x:Static svc:Loc.ResetColorHint}" />
                                    <TextBlock VerticalAlignment="Center" Classes="strong" Text="{x:Static svc:Loc.ColorAndSharpness}" />
                                </DockPanel>

                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold" Text="{Binding BrightnessText}" />
                                        <TextBlock Classes="muted" Text="{x:Static svc:Loc.Brightness}" />
                                    </DockPanel>
                                    <Slider Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding Brightness}" AutomationProperties.Name="{x:Static svc:Loc.Brightness}" />
                                </StackPanel>

                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold" Text="{Binding ContrastText}" />
                                        <TextBlock Classes="muted" Text="{x:Static svc:Loc.Contrast}" />
                                    </DockPanel>
                                    <Slider Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding Contrast}" AutomationProperties.Name="{x:Static svc:Loc.Contrast}" />
                                </StackPanel>

                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold" Text="{Binding SaturationText}" />
                                        <TextBlock Classes="muted" Text="{x:Static svc:Loc.Saturation}" />
                                    </DockPanel>
                                    <Slider Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding Saturation}" AutomationProperties.Name="{x:Static svc:Loc.Saturation}" />
                                </StackPanel>

                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold" Text="{Binding ShadowsText}" />
                                        <TextBlock Classes="muted" Text="{x:Static svc:Loc.Shadows}" ToolTip.Tip="{x:Static svc:Loc.ShadowsHint}" />
                                    </DockPanel>
                                    <Slider Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding Shadows}" ToolTip.Tip="{x:Static svc:Loc.ShadowsHint}" AutomationProperties.Name="{x:Static svc:Loc.Shadows}" />
                                </StackPanel>

                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold" Text="{Binding HighlightsText}" />
                                        <TextBlock Classes="muted" Text="{x:Static svc:Loc.Highlights}" ToolTip.Tip="{x:Static svc:Loc.HighlightsHint}" />
                                    </DockPanel>
                                    <Slider Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding Highlights}" ToolTip.Tip="{x:Static svc:Loc.HighlightsHint}" AutomationProperties.Name="{x:Static svc:Loc.Highlights}" />
                                </StackPanel>

                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold" Text="{Binding SharpnessText}" />
                                        <TextBlock Classes="muted" Text="{x:Static svc:Loc.Sharpness}" />
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding Sharpness}" AutomationProperties.Name="{x:Static svc:Loc.Sharpness}" />
                                </StackPanel>
                            </StackPanel>

                            <!--  Last frame's cost on the GPU; why artifact removal is not running  -->
                            <StackPanel Spacing="4" DataContext="{Binding Processing}" x:DataType="vm:ProcessingViewModel">
                                <TextBlock Classes="muted" FontWeight="SemiBold" Text="{Binding StatsText}" TextWrapping="Wrap" IsVisible="{Binding HasStats}" />
                                <TextBlock Classes="muted" Text="{Binding ArtifactErrorText}" TextWrapping="Wrap" IsVisible="{Binding HasArtifactError}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    </StackPanel>
                </ScrollViewer>
                  </TabItem>

                  <!--  AI on this PC: object analysis and hands. Experimental  -->
                  <TabItem Header="{x:Static svc:Loc.TabExperiments}">
                <ScrollViewer>
                    <StackPanel>
                        <Border Margin="20,14,20,16" Padding="12" CornerRadius="10" Classes="softAccent">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="strong" Text="{x:Static svc:Loc.ExperimentsTitle}" />
                                    <TextBlock Classes="muted" Text="{x:Static svc:Loc.ExperimentsHint}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button HorizontalAlignment="Stretch" Height="34" Classes="secondary" Command="{Binding DisableExperimentsCommand}"
                                        Content="{x:Static svc:Loc.ExperimentsDisableAll}" ToolTip.Tip="{x:Static svc:Loc.ExperimentsDisableAllHint}" />
                            </StackPanel>
                        </Border>

                        <!--  Object analysis (HitCam Vision): boxes over the preview and, if asked, in the camera picture  -->
                        <Border Margin="20,0,20,16">
                            <views:VisionPanel DataContext="{Binding Vision}" />
                        </Border>

                        <!--  Hand tracking: points on the fingers, gestures, threads  -->
                        <Border Margin="20,0,20,16" Padding="0,16,0,0" BorderBrush="{DynamicResource HcBorder}" BorderThickness="0,1,0,0">
                            <views:HandsPanel DataContext="{Binding Hands}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                  </TabItem>
                </TabControl>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
