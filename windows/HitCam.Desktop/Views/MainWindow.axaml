<Window
    x:Class="HitCam.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="clr-namespace:HitCam.Desktop.Services"
    xmlns:vm="clr-namespace:HitCam.Desktop.ViewModels"
    Title="HitCam"
    Width="900"
    Height="560"
    MinWidth="760"
    MinHeight="480"
    x:DataType="vm:MainViewModel"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="24" RowDefinitions="*,Auto">

        <!--  Waiting for a phone: QR code and addresses  -->
        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsWaiting}">
            <Border
                Width="232"
                Height="232"
                Padding="8"
                VerticalAlignment="Top"
                Background="White"
                CornerRadius="12">
                <Image Source="{Binding QrCode}" RenderOptions.BitmapInterpolationMode="None" />
            </Border>
            <StackPanel Grid.Column="1" Margin="24,0,0,0" Spacing="12">
                <TextBlock Classes="H3" Text="{x:Static svc:Loc.WaitingTitle}" Theme="{StaticResource TitleTextBlock}" />
                <TextBlock Text="{x:Static svc:Loc.WaitingHint}" TextWrapping="Wrap" />
                <SelectableTextBlock
                    FontFamily="Consolas,monospace"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="{Binding Addresses}" />
            </StackPanel>
        </Grid>

        <!--  Streaming: stats on the left, camera settings on the right  -->
        <Grid ColumnDefinitions="*,24,340" IsVisible="{Binding IsConnected}">
        <StackPanel Spacing="16">
            <TextBlock Classes="H3" Text="{Binding StatusText}" Theme="{StaticResource TitleTextBlock}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="16">
                <TextBlock Text="{x:Static svc:Loc.Stream}" Opacity="0.7" />
                <TextBlock Grid.Column="1" Text="{Binding StreamText}" />
                <TextBlock Grid.Row="1" Text="{x:Static svc:Loc.Received}" Opacity="0.7" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReceivedText}" />
                <TextBlock Grid.Row="2" Text="{x:Static svc:Loc.Latency}" Opacity="0.7" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LatencyText}" />
                <TextBlock Grid.Row="3" Text="{x:Static svc:Loc.Phone}" Opacity="0.7" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PhoneText}" />
            </Grid>
            <TextBlock Opacity="0.7" Text="{x:Static svc:Loc.CameraHint}" TextWrapping="Wrap" />
            <Button HorizontalAlignment="Left" Command="{Binding DisconnectCommand}" Content="{x:Static svc:Loc.Disconnect}" />
        </StackPanel>

        <Border
            Grid.Column="2"
            Padding="16"
            Background="{DynamicResource SemiColorFill0}"
            CornerRadius="12">
            <ScrollViewer>
                <StackPanel DataContext="{Binding Controls}" x:DataType="vm:CameraControlsViewModel" Spacing="10">
                    <TextBlock FontWeight="SemiBold" Text="{x:Static svc:Loc.CameraSettings}" />
                    <TextBlock Opacity="0.7" Text="{x:Static svc:Loc.WaitingForPhoneSettings}" IsVisible="{Binding !IsAvailable}" />

                    <StackPanel IsEnabled="{Binding IsAvailable}" Spacing="10">
                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                            <TextBlock VerticalAlignment="Center" Opacity="0.7" Text="{x:Static svc:Loc.Lens}" />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}" />
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Opacity="0.7" Text="{x:Static svc:Loc.Quality}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}" />
                        </Grid>

                        <StackPanel IsVisible="{Binding CanZoom}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ZoomText}" />
                                <TextBlock Opacity="0.7" Text="{x:Static svc:Loc.Zoom}" />
                            </DockPanel>
                            <Slider Maximum="{Binding MaxZoom}" Minimum="{Binding MinZoom}" Value="{Binding Zoom}" />
                        </StackPanel>

                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ExposureText}" />
                                <TextBlock Opacity="0.7" Text="{x:Static svc:Loc.Exposure}" />
                            </DockPanel>
                            <Slider Maximum="2" Minimum="-2" Value="{Binding ExposureBias}" />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding SupportsFocus}">
                            <DockPanel>
                                <ToggleButton
                                    DockPanel.Dock="Right"
                                    Command="{Binding AutoFocusCommand}"
                                    Content="{x:Static svc:Loc.AutoFocus}"
                                    IsChecked="{Binding IsAutoFocus, Mode=OneWay}" />
                                <TextBlock VerticalAlignment="Center" Opacity="0.7" Text="{x:Static svc:Loc.Focus}" />
                            </DockPanel>
                            <Slider Maximum="1" Minimum="0" Value="{Binding LensPosition}" />
                        </StackPanel>

                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                            <ToggleButton Content="{x:Static svc:Loc.Torch}" IsChecked="{Binding Torch}" IsVisible="{Binding HasTorch}" />
                            <ToggleButton Content="{x:Static svc:Loc.Mirror}" IsChecked="{Binding Mirror}" />
                            <Button Command="{Binding RotateCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Static svc:Loc.Rotate}" />
                                    <TextBlock Opacity="0.7" Text="{Binding RotationText}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
        </Grid>

        <!--  Pairing overlay  -->
        <Border
            Grid.RowSpan="2"
            Margin="-24"
            Background="{DynamicResource SemiColorBackground0}"
            IsVisible="{Binding IsPairing}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <TextBlock HorizontalAlignment="Center" Text="{Binding PinDevice}" Opacity="0.7" />
                <TextBlock HorizontalAlignment="Center" Classes="H3" Text="{x:Static svc:Loc.PairingTitle}" Theme="{StaticResource TitleTextBlock}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="Consolas,monospace"
                    FontSize="56"
                    FontWeight="Bold"
                    LetterSpacing="8"
                    Text="{Binding Pin}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="8">
            <!--  Virtual camera status, shown in every state  -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock VerticalAlignment="Center" Text="{Binding CameraText}" TextWrapping="Wrap" />
                <Button
                    Grid.Column="1"
                    Command="{Binding InstallCameraCommand}"
                    Content="{Binding InstallCameraLabel}"
                    IsVisible="{Binding CanInstallCamera}" />
            </Grid>
            <TextBlock Opacity="0.6" Text="{Binding StatusText}" IsVisible="{Binding IsWaiting}" />
        </StackPanel>
    </Grid>
</Window>
