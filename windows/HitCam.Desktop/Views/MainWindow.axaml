<Window
    x:Class="HitCam.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="clr-namespace:HitCam.Desktop.Views"
    xmlns:vm="clr-namespace:HitCam.Desktop.ViewModels"
    Title="HitCam"
    Width="1120"
    Height="720"
    MinWidth="980"
    MinHeight="640"
    Icon="/Assets/HitCam.ico"
    x:DataType="vm:MainViewModel"
    WindowStartupLocation="CenterScreen">

    <Panel Margin="0,12,0,0">
        <v:WaitingView IsVisible="{Binding IsWaiting}" />
        <v:PairingView IsVisible="{Binding IsPairing}" />
        <v:StreamingView IsVisible="{Binding IsConnected}" />
    </Panel>
</Window>
