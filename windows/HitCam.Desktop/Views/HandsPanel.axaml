<UserControl
    x:Class="HitCam.Desktop.Views.HandsPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="clr-namespace:HitCam.Desktop.Services"
    xmlns:vm="clr-namespace:HitCam.Desktop.ViewModels"
    x:DataType="vm:HandsViewModel">

    <UserControl.Resources>
        <!--  Switches without the Fluent "On/Off" text column, which is 154 px wide  -->
        <x:Double x:Key="ToggleSwitchThemeMinWidth">0</x:Double>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="ToggleSwitch.bare">
            <Setter Property="OnContent" Value="{x:Null}" />
            <Setter Property="OffContent" Value="{x:Null}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="14">
        <!--  No models next to the app or in LocalAppData  -->
        <Border Padding="12" CornerRadius="10" Classes="softAccent" IsVisible="{Binding HasNoModels}">
            <SelectableTextBlock FontSize="12" Text="{Binding NoModelsText}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Spacing="14" IsVisible="{Binding HasModels}">
            <DockPanel ToolTip.Tip="{x:Static svc:Loc.HandsPointsHint}">
                <ToggleSwitch Margin="12,0,0,0" DockPanel.Dock="Right" Classes="bare" IsChecked="{Binding ShowPoints}"
                              AutomationProperties.Name="{x:Static svc:Loc.HandsPoints}" />
                <TextBlock VerticalAlignment="Center" Classes="strong" Text="{x:Static svc:Loc.HandsPoints}" TextWrapping="Wrap" />
            </DockPanel>

            <DockPanel ToolTip.Tip="{x:Static svc:Loc.HandsSkeletonHint}" IsEnabled="{Binding ShowPoints}">
                <ToggleSwitch Margin="12,0,0,0" DockPanel.Dock="Right" Classes="bare" IsChecked="{Binding ShowSkeleton}"
                              AutomationProperties.Name="{x:Static svc:Loc.HandsSkeleton}" />
                <TextBlock VerticalAlignment="Center" Classes="strong" Text="{x:Static svc:Loc.HandsSkeleton}" TextWrapping="Wrap" />
            </DockPanel>

            <StackPanel Spacing="4">
                <DockPanel ToolTip.Tip="{x:Static svc:Loc.HandsShotsHint}">
                    <ToggleSwitch Margin="12,0,0,0" DockPanel.Dock="Right" Classes="bare" IsChecked="{Binding ShotsEnabled}"
                                  AutomationProperties.Name="{x:Static svc:Loc.HandsShots}" />
                    <TextBlock VerticalAlignment="Center" Classes="strong" Text="{x:Static svc:Loc.HandsShots}" TextWrapping="Wrap" />
                </DockPanel>
                <TextBlock Classes="muted" FontSize="12" Text="{x:Static svc:Loc.HandsShotsHint}" TextWrapping="Wrap" />
            </StackPanel>

            <!--  Threads between the same fingertips of both hands, and the fills between them  -->
            <StackPanel Spacing="10">
                <DockPanel ToolTip.Tip="{x:Static svc:Loc.HandsThreadsHint}">
                    <ToggleSwitch Margin="12,0,0,0" DockPanel.Dock="Right" Classes="bare" IsChecked="{Binding ThreadsEnabled}"
                                  AutomationProperties.Name="{x:Static svc:Loc.HandsThreads}" />
                    <TextBlock VerticalAlignment="Center" Classes="strong" Text="{x:Static svc:Loc.HandsThreads}" TextWrapping="Wrap" />
                </DockPanel>
                <TextBlock Classes="muted" FontSize="12" Text="{x:Static svc:Loc.HandsThreadsHint}" TextWrapping="Wrap" />
                <StackPanel Spacing="10" IsEnabled="{Binding ThreadsEnabled}">
                    <DockPanel>
                        <ColorPicker DockPanel.Dock="Right" Color="{Binding LeftColor}" IsAlphaVisible="False"
                                     AutomationProperties.Name="{x:Static svc:Loc.HandsLeftColor}" />
                        <TextBlock VerticalAlignment="Center" Classes="muted" Text="{x:Static svc:Loc.HandsLeftColor}" />
                    </DockPanel>
                    <DockPanel>
                        <ColorPicker DockPanel.Dock="Right" Color="{Binding RightColor}" IsAlphaVisible="False"
                                     AutomationProperties.Name="{x:Static svc:Loc.HandsRightColor}" />
                        <TextBlock VerticalAlignment="Center" Classes="muted" Text="{x:Static svc:Loc.HandsRightColor}" />
                    </DockPanel>
                    <TextBlock Classes="muted" FontSize="12" Text="{x:Static svc:Loc.HandsColorsHint}" TextWrapping="Wrap" />
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold" Text="{Binding FillOpacityText}" />
                            <TextBlock Classes="muted" Text="{x:Static svc:Loc.HandsFillOpacity}" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding FillOpacity}" AutomationProperties.Name="{x:Static svc:Loc.HandsFillOpacity}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!--  What also goes into the camera picture  -->
            <StackPanel Spacing="6">
                <TextBlock Classes="muted" Text="{x:Static svc:Loc.HandsCamera}" ToolTip.Tip="{x:Static svc:Loc.HandsCameraHint}" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                    <CheckBox Content="{x:Static svc:Loc.HandsCameraPoints}" IsChecked="{Binding CameraPoints}" />
                    <CheckBox Grid.Column="1" Content="{x:Static svc:Loc.HandsCameraThreads}" IsChecked="{Binding CameraThreads}" />
                    <CheckBox Grid.Row="1" Content="{x:Static svc:Loc.HandsCameraFill}" IsChecked="{Binding CameraFill}" />
                    <CheckBox Grid.Row="1" Grid.Column="1" Content="{x:Static svc:Loc.HandsCameraShots}" IsChecked="{Binding CameraShots}" />
                </Grid>
            </StackPanel>

            <!--  What runs and how fast; why it does not  -->
            <StackPanel Spacing="4">
                <TextBlock Classes="muted" FontWeight="SemiBold" Text="{Binding StatsText}" TextWrapping="Wrap" IsVisible="{Binding HasStats}" />
                <TextBlock Classes="muted" Foreground="{StaticResource HcLive}" Text="{Binding ErrorText}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
