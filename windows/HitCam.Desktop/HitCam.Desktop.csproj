<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>HitCam.Desktop</RootNamespace>
    <AssemblyName>HitCam</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\HitCam.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- System.Reactive's Windows build pulls in the whole WPF/WinForms runtime (~100 MB) that Avalonia never uses. -->
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!-- The colour pickers of the thread fill. -->
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="ReactiveUI.Avalonia" />
    <PackageReference Include="QRCoder" />
    <!-- Already there through Avalonia; used directly to draw labels into the camera picture. -->
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HitCam.Core\HitCam.Core.csproj" />
    <!-- Object analysis. Its native ONNX Runtime and DirectML DLLs are published next to HitCam.exe, not bundled. -->
    <ProjectReference Include="..\HitCam.Vision\HitCam.Vision.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\HitCam.ico" />
  </ItemGroup>

  <!--
    Debug symbols (ours and the native Skia/HarfBuzz ones, ~100 MB) do not belong in an installed app, nor does
    ONNX Runtime's import library. onnxruntime.dll and DirectML.dll stay next to HitCam.exe (native, not bundled).
  -->
  <Target Name="RemovePublishedSymbols" AfterTargets="Publish">
    <ItemGroup>
      <PublishedSymbols Include="$(PublishDir)*.pdb;$(PublishDir)*.lib" />
    </ItemGroup>
    <Delete Files="@(PublishedSymbols)" />
  </Target>

  <!--
    The virtual camera (C++, windows/HitCam.VCam) needs Visual Studio with "Desktop development with C++".
    Build with -p:SkipVirtualCamera=true to skip it; the app then runs without the camera.
  -->
  <PropertyGroup>
    <VCamDir>$(MSBuildThisFileDirectory)..\HitCam.VCam\</VCamDir>
    <VCamDll>$(VCamDir)build\Release\HitCamVCam.dll</VCamDll>
    <!-- The DirectShow camera for Windows 10: 64-bit, and 32-bit for 32-bit apps. -->
    <VCamDShowDll>$(VCamDir)build\Release\HitCamDShow.dll</VCamDShowDll>
    <VCamDShow32Dll>$(VCamDir)build32\Release\HitCamDShow32.dll</VCamDShow32Dll>
  </PropertyGroup>
  <ItemGroup>
    <VCamSource Include="$(VCamDir)src\**;$(VCamDir)CMakeLists.txt;$(VCamDir)build.ps1;$(VCamDir)third_party\softcam\**;$(VCamDir)third_party\nvvfx\**" />
  </ItemGroup>
  <Target Name="BuildVirtualCamera" BeforeTargets="BeforeBuild" Condition="'$(OS)' == 'Windows_NT' And '$(SkipVirtualCamera)' != 'true'"
          Inputs="@(VCamSource)" Outputs="$(VCamDll)">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(VCamDir)build.ps1&quot;" />
  </Target>
  <Target Name="CopyVirtualCamera" AfterTargets="BuildVirtualCamera" BeforeTargets="BeforeBuild" Condition="Exists('$(VCamDll)')">
    <ItemGroup>
      <None Include="$(VCamDll)" Link="HitCamVCam.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <None Include="$(VCamDShowDll)" Link="HitCamDShow.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(VCamDShowDll)')" />
      <None Include="$(VCamDShow32Dll)" Link="HitCamDShow32.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(VCamDShow32Dll)')" />
    </ItemGroup>
  </Target>
  <!--
    The app only ever installs (with admin rights) the exact DLL it was built with: its SHA-256 goes into HitCam.exe
    as [AssemblyMetadata("HitCamVCamSha256", ...)]. Without the DLL there is no hash and installing is not offered.
    The DirectShow camera's two DLLs get HitCamDShowSha256 and HitCamDShow32Sha256 the same way.
  -->
  <Target Name="EmbedVirtualCameraHash" AfterTargets="CopyVirtualCamera" BeforeTargets="BeforeBuild" Condition="Exists('$(VCamDll)')">
    <GetFileHash Files="$(VCamDll)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Hash" PropertyName="VCamSha256" />
    </GetFileHash>
    <GetFileHash Files="$(VCamDShowDll)" Algorithm="SHA256" HashEncoding="hex" Condition="Exists('$(VCamDShowDll)')">
      <Output TaskParameter="Hash" PropertyName="VCamDShowSha256" />
    </GetFileHash>
    <GetFileHash Files="$(VCamDShow32Dll)" Algorithm="SHA256" HashEncoding="hex" Condition="Exists('$(VCamDShow32Dll)')">
      <Output TaskParameter="Hash" PropertyName="VCamDShow32Sha256" />
    </GetFileHash>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>HitCamVCamSha256</_Parameter1>
        <_Parameter2>$(VCamSha256)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(VCamDShowSha256)' != ''">
        <_Parameter1>HitCamDShowSha256</_Parameter1>
        <_Parameter2>$(VCamDShowSha256)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(VCamDShow32Sha256)' != ''">
        <_Parameter1>HitCamDShow32Sha256</_Parameter1>
        <_Parameter2>$(VCamDShow32Sha256)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
</Project>
