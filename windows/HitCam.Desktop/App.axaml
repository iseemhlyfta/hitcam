<Application
    x:Class="HitCam.Desktop.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Name="HitCam"
    RequestedThemeVariant="Default">

    <!--  Palette from the design mockup; "Default" follows the Windows light/dark setting.  -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Views/FeatureSection.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="HcGround" Color="#F4F3F0" />
                    <SolidColorBrush x:Key="HcSurface" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HcSurface2" Color="#F9F8F6" />
                    <SolidColorBrush x:Key="HcBorder" Color="#E4E2DD" />
                    <SolidColorBrush x:Key="HcText" Color="#1A1A19" />
                    <SolidColorBrush x:Key="HcText2" Color="#5E5C57" />
                    <SolidColorBrush x:Key="HcAccent" Color="#6D28D9" />
                    <SolidColorBrush x:Key="HcAccentHover" Color="#5B21B6" />
                    <SolidColorBrush x:Key="HcOnAccent" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HcAccentSoft" Color="#EDE7FB" />
                    <SolidColorBrush x:Key="HcAccentSoftText" Color="#5B21B6" />
                    <SolidColorBrush x:Key="HcOk" Color="#1E7F4F" />
                    <SolidColorBrush x:Key="HcOkSoft" Color="#E2F3EA" />
                    <SolidColorBrush x:Key="HcSelected" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="HcGround" Color="#1F1F1E" />
                    <SolidColorBrush x:Key="HcSurface" Color="#2A2A28" />
                    <SolidColorBrush x:Key="HcSurface2" Color="#323230" />
                    <SolidColorBrush x:Key="HcBorder" Color="#3D3C39" />
                    <SolidColorBrush x:Key="HcText" Color="#F2F1EE" />
                    <SolidColorBrush x:Key="HcText2" Color="#B3B0A8" />
                    <SolidColorBrush x:Key="HcAccent" Color="#B69CFF" />
                    <SolidColorBrush x:Key="HcAccentHover" Color="#CDB8FF" />
                    <SolidColorBrush x:Key="HcOnAccent" Color="#1B0F33" />
                    <SolidColorBrush x:Key="HcAccentSoft" Color="#2E2345" />
                    <SolidColorBrush x:Key="HcAccentSoftText" Color="#CDB8FF" />
                    <SolidColorBrush x:Key="HcOk" Color="#5CCB8F" />
                    <SolidColorBrush x:Key="HcOkSoft" Color="#1D3328" />
                    <SolidColorBrush x:Key="HcSelected" Color="#45443F" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--  The video area stays dark in both themes.  -->
            <SolidColorBrush x:Key="HcVideo" Color="#0E0E0D" />
            <SolidColorBrush x:Key="HcOverlay" Color="#B80E0E0D" />
            <SolidColorBrush x:Key="HcOnVideo" Color="#F2F1EE" />
            <SolidColorBrush x:Key="HcVideoMuted" Color="#8C8A84" />
            <SolidColorBrush x:Key="HcLive" Color="#F2553A" />
            <!--  White balance sliders show how the picture changes (as in photo editors)  -->
            <LinearGradientBrush x:Key="HcTemperatureGradient" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Offset="0" Color="#5B8DEF" />
                <GradientStop Offset="0.5" Color="#D9D6CF" />
                <GradientStop Offset="1" Color="#E9A23B" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HcTintGradient" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Offset="0" Color="#4DAA57" />
                <GradientStop Offset="0.5" Color="#D9D6CF" />
                <GradientStop Offset="1" Color="#C45BC0" />
            </LinearGradientBrush>
            <FontFamily x:Key="HcDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
            <FontFamily x:Key="HcMonoFont">Cascadia Mono, Consolas</FontFamily>

            <!--  Stroke icons (24x24), drawn with Path.icon  -->
            <StreamGeometry x:Key="IconPhone">M9 2 H15 A3 3 0 0 1 18 5 V19 A3 3 0 0 1 15 22 H9 A3 3 0 0 1 6 19 V5 A3 3 0 0 1 9 2 Z M11 18 H13</StreamGeometry>
            <StreamGeometry x:Key="IconVideo">M5 5 H15 A2 2 0 0 1 17 7 V17 A2 2 0 0 1 15 19 H5 A2 2 0 0 1 3 17 V7 A2 2 0 0 1 5 5 Z M17 10 L21 7 V17 L17 14</StreamGeometry>
            <StreamGeometry x:Key="IconFullscreen">M4 9 V4 H9 M20 9 V4 H15 M4 15 V20 H9 M20 15 V20 H15</StreamGeometry>
            <StreamGeometry x:Key="IconCopy">M11 9 H18 A2 2 0 0 1 20 11 V18 A2 2 0 0 1 18 20 H11 A2 2 0 0 1 9 18 V11 A2 2 0 0 1 11 9 Z M5 15 V6 A2 2 0 0 1 7 4 H16</StreamGeometry>
            <StreamGeometry x:Key="IconShield">M12 3 L20 6 V12 C20 17 16.5 20 12 21 C7.5 20 4 17 4 12 V6 Z</StreamGeometry>
            <StreamGeometry x:Key="IconLock">M7 11 H17 A2 2 0 0 1 19 13 V19 A2 2 0 0 1 17 21 H7 A2 2 0 0 1 5 19 V13 A2 2 0 0 1 7 11 Z M8 11 V8 A4 4 0 0 1 16 8 V11</StreamGeometry>
            <StreamGeometry x:Key="IconTorch">M8 2 H16 L15 8 H9 Z M9 8 L10 22 H14 L15 8</StreamGeometry>
            <StreamGeometry x:Key="IconMirror">M12 3 V21 M8 7 L3 12 L8 17 Z M16 7 L21 12 L16 17 Z</StreamGeometry>
            <StreamGeometry x:Key="IconRotate">M20 11 A8 8 0 1 0 17.7 16.7 M20 4 V11 H13</StreamGeometry>
            <StreamGeometry x:Key="IconCheckCircle">M21 12 A9 9 0 1 1 3 12 A9 9 0 1 1 21 12 Z M8 12 L11 15 L16 9</StreamGeometry>
            <StreamGeometry x:Key="IconExitFullscreen">M9 4 V9 H4 M15 4 V9 H20 M9 20 V15 H4 M15 20 V15 H20</StreamGeometry>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#6D28D9" />
                <ColorPaletteResources x:Key="Dark" Accent="#B69CFF" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <StyleInclude Source="/Styles.axaml" />
    </Application.Styles>
</Application>
